# ─────────────────────────────────────────────────────────────
#  Server-only settings. Add these in Vercel → Project → Settings
#  → Environment Variables (or in a local .env file for `vercel dev`).
#  NEVER prefix them with VITE_ — that would ship them to browsers.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API (or "Data API") → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → the SECRET key (sb_secret_…)
# or, on older projects, the "service_role" key. Keep this private.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
